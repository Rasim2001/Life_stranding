#!/bin/sh
# spiderrig-hook v1
# Гард на артефакты запекания и их .meta во всём проекте (docs/scene-regulations.md §10).
# Блобы APV, лайтмапы, отражения и сгенерированные данные не версионируются — бейк это одна машина,
# та же, с которой уходит билд. Ставится автоматически GitHooksInstaller.cs.

STAGED=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR)

FORBIDDEN=$(printf '%s\n' "$STAGED" | grep -E \
    -e '(^|/)[^/]*\.Cell[^/]*\.bytes(\.meta)?$' \
    -e '(^|/)Lightmap-[^/]*\.(exr|png)(\.meta)?$' \
    -e '(^|/)ReflectionProbe-[^/]*\.exr(\.meta)?$' \
    -e '(^|/)LightingData\.asset(\.meta)?$' \
    -e '(^|/)OcclusionCullingData\.asset(\.meta)?$' \
    -e '(^|/)NavMesh\.asset(\.meta)?$' \
    -e '(^|/)LightmapSnapshot\.asset(\.meta)?$')

if [ -z "$FORBIDDEN" ]; then
    exit 0
fi

if [ -f .allow-bake-commit ]; then
    echo "spiderrig-hook: разрешение .allow-bake-commit израсходовано, коммит бейка пропущен."
    rm -f .allow-bake-commit
    exit 0
fi

echo "spiderrig-hook: в коммите артефакты запекания или их .meta — их нельзя версионировать:"
printf '%s\n' "$FORBIDDEN"
echo ""
echo "Правило: артефакты бейка и их .meta не версионируются (docs/scene-regulations.md §10)."
echo "Осознанный разовый коммит: touch .allow-bake-commit && git add ... && git commit ..."
exit 1
