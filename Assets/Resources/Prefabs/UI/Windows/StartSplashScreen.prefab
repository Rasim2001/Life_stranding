      propertyPath: m_text
      value: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442\u0435
        \u0432 \u043F\u043B\u0435\u0439\u0442\u0435\u0441\u0442\u0435!<br>\n\u041F\u043E\u0441\u043B\u0435
        \u0432\u044B\u0445\u043E\u0434\u0430 \u0438\u0437 \u0438\u0433\u0440\u044B
