      Data: 17|Infastructure.StaticData.Product.ProductDescription, Assembly-CSharp
    - Name: TitleText
      Entry: 1
      Data: "<sprite=15><font-weight=\"500\">\u0418\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u044B\u0439
        \u0441\u043A\u0430\u043D\u0435\u0440</font-weight>"
    - Name: HowToUseText
      Entry: 1
      Data: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 <sprite=17> \u0434\u043B\u044F
        \u0441\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
        \u0440\u0435\u043B\u044C\u0435\u0444\u0430"
    - Name: DescriptionText
      Entry: 1
      Data: "\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
        \u0440\u0435\u043B\u044C\u0435\u0444\u0430 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
        \u0443\u0437\u043D\u0430\u0442\u044C \u043A\u0430\u043A \u0438 \u0433\u0434\u0435
        \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435 \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0442\u044C.
        \u0421\u0438\u043C\u0432\u043E\u043B\u044B \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
        \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0435 \u043F\u0443\u0442\u0438
        \u0438 \u0437\u043E\u043D\u044B \u0440\u0438\u0441\u043A\u0430. \u041C\u0430\u043B\u043E
        \u043A\u043E\u043C\u0443 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
        \u0447\u0442\u043E \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F \u0441\u043E\u0431\u0440\u0430\u043D
        \u043D\u0430 \u0431\u0430\u0437\u0435 LiDAR i17 Pro Max, \u043A\u043E\u0434\u043E\u0432\u043E\u0435
        \u0438\u043C\u044F XZ-3000."
