      Data: "\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u044F \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u043E\u0439,
        \u0432\u044B \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0435
        \u0433\u0440\u0443\u0437 \u0432 \u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u0438
        \u0438 \u043D\u0435 \u0434\u0430\u0451\u0442\u0435 \u0435\u043C\u0443 \u0441\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u0442\u044C.
        \u041A\u0430\u0436\u0434\u043E\u0435 \u043F\u0430\u0434\u0435\u043D\u0438\u0435
        \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0430\u0435\u0442 \u0433\u0440\u0443\u0437
        \u0438 \u043E\u0442\u043D\u0438\u043C\u0430\u0435\u0442 \u043E\u0447\u043A\u0438
        \u0425\u041F<sprite=20> . \u041A\u043E\u0433\u0434\u0430 \u0425\u041F \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0441\u044F
        \u0434\u043E \u043D\u0443\u043B\u044F, \u0433\u0440\u0443\u0437 \u0431\u0443\u0434\u0435\u0442
        \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D. \u0411\u0435\u0440\u0435\u0433\u0438\u0442\u0435
        \u0446\u0435\u043D\u043D\u044B\u0439 \u0433\u0440\u0443\u0437."
