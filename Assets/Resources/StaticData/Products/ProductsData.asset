      Data: 11|Infastructure.StaticData.Product.ProductDescription, Assembly-CSharp
    - Name: TitleText
      Entry: 1
      Data: "<sprite=15><font-weight=\"500\">\u041F\u0440\u044B\u0436\u043E\u043A</font-weight>"
    - Name: HowToUseText
      Entry: 1
      Data: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439  <sprite=9>\u0434\u043B\u044F
        \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u043E\u0433\u043E
        \u043F\u0440\u044B\u0436\u043A\u0430."
    - Name: DescriptionText
      Entry: 1
      Data: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F \u043F\u0440\u044B\u0436\u043E\u043A
        \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043B\u0430\u0432\u043D\u043E
        \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0442\u044C \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u0438.
        \u041D\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u044F
        \u043E \u0441\u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0441\u0442\u0438
        \u043A\u043E\u043B\u0431\u044B, \u043E\u043D\u0430 \u043D\u0430\u043C\u0435\u0440\u0442\u0432\u043E
        \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F
        \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435.  \u041E\u0434\u043D\u0430\u043A\u043E
        \u043F\u0440\u044B\u0436\u043E\u043A <color=#B9DDEA>\u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442
        \u044D\u043D\u0435\u0440\u0433\u0438\u044E</color> <sprite=21>,    \u0447\u0435\u043C
        \u0434\u043E\u043B\u044C\u0448\u0435 \u0434\u0435\u0440\u0436\u0438\u0448\u044C,
        \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442\u0441\u044F.
        \u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044E \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043B
        \u041D\u0418\u0418 \u0430\u044D\u0440\u043E\u0434\u0438\u043D\u0430\u043C\u0438\u043A\u0438;
        \u0431\u0430\u0437\u0438\u0440\u0443\u044F\u0441\u044C \u043D\u0430 \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u0435
        \u0440\u0430\u043D\u0446\u0435\u0432\u043E\u0433\u043E \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044F.
        \u0425\u043E\u0442\u0435\u043B\u0438 \u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C
        \u0432\u044B\u0448\u0435 \u0433\u043E\u043B\u043E\u0432\u044B."
