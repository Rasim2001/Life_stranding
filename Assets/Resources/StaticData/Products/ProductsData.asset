    - Name: $v
      Entry: 1
      Data: "\u0411\u0435\u0433 \u043A\u0430\u043A \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
        \u0430\u0433\u0440\u0435\u0433\u0430\u0442\u044B \u0442\u043E\u0436\u0435
        <color=#B9DDEA>\u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442 \u044D\u043D\u0435\u0440\u0433\u0438\u044E</color> 
        <sprite=21> \u043D\u0435 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        ;) \u0421\u0443\u0434\u044F \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u044D\u0442\u043E\u0442
        \u0443\u0441\u043A\u043E\u0440\u0438\u0442\u0435\u043B\u044C \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B
        \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u0441 \u0441\u0430\u043C\u044B\u043C\u0438
        \u0431\u044B\u0441\u0442\u0440\u044B\u043C\u0438 \u0438 \u043D\u0430\u0434\u0435\u0436\u043D\u044B\u043C\u0438
        \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0430\u043C\u0438. \u041F\u043E\u0441\u043B\u0435
        \u0433\u0438\u0431\u0435\u043B\u0438 \u043C\u0438\u0440\u0430 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u044B
        \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u043B\u0438\u0441\u044C
        \u0447\u0435\u0440\u0435\u0437 \u0434\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u043E\u0432
        \u0442\u0430\u043A \u0436\u0435 \u0431\u044B\u0441\u0442\u0440\u043E \u0438
        \u043D\u0430\u0434\u0451\u0436\u043D\u043E."
