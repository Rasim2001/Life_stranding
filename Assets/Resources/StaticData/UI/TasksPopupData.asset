    - Name: $v
      Entry: 1
      Data: "\u0412 \u043A\u043E\u043B\u0431\u0435<sprite=19> \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F
        <color=#B9DDEA>\u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u043E\u0441\u0442\u043E\u043A</color>.
        <color=#B9DDEA>\u0414\u043E\u0441\u0442\u0430\u0432\u044C</color> \u0435\u0433\u043E
        <color=#B9DDEA>\u0432</color> \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u0443\u044E
        \u0431\u0438\u043E\u0441\u0444\u0435\u0440\u0443 \u0441\u0438\u0441\u0442\u0435\u043C
        \u0436\u0438\u0437\u043D\u0435\u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F.
        \u041F\u043E\u0445\u043E\u0436\u0435 \u043A\u043E\u043C\u0435\u0442\u044B
        \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u043B\u0438 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u0443\u044E
        \u0434\u0430\u043C\u0431\u0443 \u0438 \u0432\u043E\u0434\u0430 \u0432\u0441\u043A\u043E\u0440\u0435
        \u0437\u0430\u0442\u043E\u043F\u0438\u0442 \u0442\u0443\u0442 \u0432\u0441\u0435.
        \u0411\u0443\u0434\u0442\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E
        \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E
        \u0444\u043E\u043D\u0430, \u0440\u0436\u0430\u0432\u043E\u0439 \u0432\u043E\u0434\u044B
        \u0438 \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0435\u043D\u043D\u043E\u0433\u043E
        \u0432\u043E\u0437\u0434\u0443\u0445\u0430."
