    - Name: $v
      Entry: 1
      Data: "\u0411\u0438\u043E\u0441\u0444\u0435\u0440\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
        \u0432 \u0431\u0435\u0437\u0437\u0430\u0449\u0438\u0442\u043D\u043E\u043C
        \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u043E\u0442 \u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0445
        \u043A\u043E\u043C\u0435\u0442  \u0438 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438,
        \u043A\u0430\u043A \u0438 \u043E\u0442 \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0435\u043D\u0438\u044F
        \u0432\u043E\u0437\u0434\u0443\u0445\u0430. \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
        <color=#B9DDEA>\u0437\u0430\u043F\u0443\u0441\u043A  4\u0445 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u0432</color>,
        \u0447\u0442\u043E \u0431\u044B \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
        \u0446\u0435\u043B\u043E\u0441\u0442\u043D\u043E\u0441\u0442\u044C \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0433\u043E
        \u043F\u043E\u043B\u044F \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
        \u0432\u0440\u0435\u043C\u044F \u0432\u043E\u0437\u0434\u0443\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u0441\u0442\u0430\u043B \u0445\u0443\u0436\u0435, \u0441 \u0447\u0435\u0433\u043E
        \u0431\u044B \u044D\u0442\u043E."
